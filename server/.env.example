# ── NeostixSnap backend ──────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# The extension never receives AI_API_KEY; it only knows the backend URL and
# the optional shared EXTENSION_TOKEN.

# openai | openrouter | anthropic | ollama | openai-compatible
AI_PROVIDER=openai

# A multimodal (vision-capable) model. Use a model that can read images.
AI_MODEL=gpt-4.1-mini

# Server-side AI provider key. Required for OpenAI, OpenRouter, and Anthropic.
AI_API_KEY=

# Optional for openai-compatible/local endpoints. Leave empty for local Ollama.
# AI_BASE_URL=https://api.openai.com/v1

# Shared secret between this backend and NeostixSnap settings.
# Use a long random value for any non-local deployment.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXTENSION_TOKEN=

HOST=127.0.0.1
PORT=8787

# Comma-separated extension origins allowed by CORS. Recommended in production.
# Find the extension ID at chrome://extensions and use:
# ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
ALLOWED_ORIGINS=

# Local development only. The server refuses to bind to a non-loopback address
# without EXTENSION_TOKEN unless this is true.
ALLOW_INSECURE_BIND=false

# Set true only behind a trusted reverse proxy so rate limiting sees the client IP.
TRUST_PROXY=false

AI_TIMEOUT_MS=60000
REQUEST_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=2500
AI_TEMPERATURE=0.2

# auto lets the backend choose JSON schema output for OpenAI and JSON object
# output for OpenRouter. Other values: json_schema | json_object | none.
AI_RESPONSE_FORMAT=auto
# auto uses max_completion_tokens for OpenAI and max_tokens elsewhere.
AI_TOKEN_PARAM=

MAX_IMAGE_BYTES=6291456
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
MAX_CONCURRENT_AI=3
MAX_QUEUE=8

# Allow the extension to request a model override. Off by default.
ALLOW_CLIENT_MODEL=false
